# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing and linting caches
.pytest_cache/
.ruff_cache/

# Output files and local logs
*.xlsx
*.log

# Personal/real PDFs outside sample_data
*.pdf
!sample_data/**

# Explicitly track trained classifier model and training data
!models/classifier.pkl
!data/training_data.csv
